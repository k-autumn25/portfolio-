rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'lizakang123@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // ---------- Public contact form messages ----------
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 5000
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    // ---------- Site content (singleton documents) ----------
    // hero, about, services, skills, contact, videos, events
    match /site_content/{section} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Projects, experience, education (collections) ----------
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experience/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /education/{eduId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
